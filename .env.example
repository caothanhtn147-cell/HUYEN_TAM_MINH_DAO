# ==============================================================================
# HUYỀN TÂM MINH ĐẠO (HuyenTam Wisdom) — Environment Configuration Example
# IMPORTANT: This file contains placeholder values ONLY for local development.
# NEVER insert real production credentials, live secrets, or private API keys here.
# ==============================================================================

# Application
APP_ENV=development
APP_NAME=HuyenTam Wisdom

# Frontend
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend
API_HOST=0.0.0.0
API_PORT=8000

# Database
DATABASE_URL=postgresql+asyncpg://postgres:change_me@localhost:5432/huyentam

# Redis
REDIS_URL=redis://localhost:6379/0

# Authentication
JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Sensitive-field encryption
FIELD_ENCRYPTION_KEY=replace_with_a_valid_key

# AI providers — leave blank
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Storage
STORAGE_PROVIDER=
STORAGE_BUCKET=
STORAGE_ENDPOINT=

# Payment providers — leave blank
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
